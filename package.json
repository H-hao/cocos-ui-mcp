{
    "$schema": "./@types/schema/package/index.json",
    "package_version": 2,
    "name": "cocos-mcp-server",
    "version": "1.4.0",
    "author": "LiDaxian",
    "editor": ">=3.8.6",
    "scripts": {
        "preinstall": "node ./scripts/preinstall.js",
        "build:panel": "vite build --config vite.panel.config.ts",
        "build:ts": "tsc",
        "build": "npm-run-all build:panel build:ts",
        "watch:panel": "vite build --config vite.panel.config.ts --watch",
        "watch:ts": "tsc -w",
        "watch": "npm-run-all --parallel watch:panel watch:ts"
    },
    "description": "i18n:cocos-mcp-server.description",
    "main": "./dist/main.js",
    "dependencies": {
        "element-plus": "^2.11.7",
        "fs-extra": "^11.3.0",
        "uuid": "^9.0.1",
        "vue": "^3.5.13"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.1",
        "@cocos/creator-types": "^3.8.6",
        "@types/fs-extra": "^9.0.5",
        "@types/node": "^22.12.0",
        "@types/uuid": "^9.0.8",
        "autoprefixer": "^10.4.20",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.4.49",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.8.2",
        "unplugin-auto-import": "^20.2.0",
        "unplugin-vue-components": "^30.0.0",
        "vite": "^7.1.5"
    },
    "panels": {
        "default": {
            "title": "i18n:cocos-mcp-server.panel_title",
            "type": "dockable",
            "main": "dist/panels/default",
            "icon": "./static/icon.png",
            "size": {
                "min-width": 1100,
                "min-height": 500,
                "width": 1100,
                "height": 800
            }
        }
    },
    "contributions": {
                "menu": [
            {
                "path": "i18n:menu.extension/Cocos MCP Server",
                "label": "i18n:cocos-mcp-server.open_panel",
                "message": "open-panel"
            }
        ],
        "messages": {
            "open-panel": {
                "methods": [
                    "openPanel"
                ]
            },
            "start-server": {
                "methods": [
                    "startServer"
                ]
            },
            "stop-server": {
                "methods": [
                    "stopServer"
                ]
            },
            "restart-server-from-dist": {
                "methods": [
                    "restartServerFromDist"
                ]
            },
            "get-server-status": {
                "methods": [
                    "getServerStatus"
                ]
            },
            "update-settings": {
                "methods": [
                    "updateSettings"
                ]
            },
            "getToolsList": {
                "methods": [
                    "getToolsList"
                ]
            },
            "get-server-settings": {
                "methods": [
                    "getServerSettings"
                ]
            },
            "getToolManagerState": {
                "methods": [
                    "getToolManagerState"
                ]
            },
            "createToolConfiguration": {
                "methods": [
                    "createToolConfiguration"
                ]
            },
            "updateToolConfiguration": {
                "methods": [
                    "updateToolConfiguration"
                ]
            },
            "deleteToolConfiguration": {
                "methods": [
                    "deleteToolConfiguration"
                ]
            },
            "setCurrentToolConfiguration": {
                "methods": [
                    "setCurrentToolConfiguration"
                ]
            },
            "updateToolStatus": {
                "methods": [
                    "updateToolStatus"
                ]
            },
            "updateToolStatusBatch": {
                "methods": [
                    "updateToolStatusBatch"
                ]
            },
            "exportToolConfiguration": {
                "methods": [
                    "exportToolConfiguration"
                ]
            },
            "importToolConfiguration": {
                "methods": [
                    "importToolConfiguration"
                ]
            },
            "getEnabledTools": {
                "methods": [
                    "getEnabledTools"
                ]
            }
        },
        "scene": {
            "script": "./dist/scene.js",
            "methods": [
                "createNewScene",
                "addComponentToNode",
                "removeComponentFromNode",
                "getNodeInfo",
                "getAllNodes",
                "findNodeByName",
                "setNodeProperty",
                "setComponentProperty",
                "setComponentProperties",
                "getCurrentSceneInfo",
                "getSceneHierarchy",
                "createPrefabFromNode"
            ]
        }
    }
}
